generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Роли (строка, без enum): OWNER/SUPER_ADMIN (владелец), ADMIN, TEAM_LEAD (тимлид/аккаунт),
// TARGETOLOG, ACCOUNTANT (бухгалтер), CONTRACTOR, DEVELOPER, EDITOR, CLIENT.
// Переименование значений — отдельная задача (см. миграцию данных позже); здесь схема
// не завязана на конкретный набор строк.
model User {
  id                String    @id @default(cuid())
  // Логин для входа — задел под вход без email (см. задачу по порталу/ролям).
  // Пока не обязателен и не используется в auth.ts — переключение входа на login
  // выполняется отдельной задачей вместе с переименованием ролей.
  login             String?   @unique
  email             String    @unique
  passwordHash      String
  name              String
  role              String
  rate              Float? // % от чека (таргетолог/программист) или фикс-ставка
  rateType          String    @default("PERCENT") // PERCENT | FIXED
  projectLimit      Int       @default(5)
  active            Boolean   @default(true)
  phone             String?
  tgChatId          String? // привязанный чат Telegram
  tgLinkCode        String?   @unique // одноразовый код привязки
  createdAt         DateTime  @default(now())
  /// Момент смены пароля: выданные раньше сессии становятся недействительными.
  passwordChangedAt DateTime?

  clientsAsTargetolog Client[]          @relation("targetolog")
  clientsAsAccount    Client[]          @relation("account")
  tasks               Task[]            @relation("assignee")
  reports             AdReport[]
  notifications       Notification[]
  memberships         ClientMember[]
  expenses            Expense[]
  marketingReports    MarketingReport[]
  taskComments        TaskComment[]
  regulations         Regulation[]      @relation("regulationOwner")
  directionsCreated   Direction[]
  adTransactions      AdTransaction[]
}

// Статусы: TEST | ACTIVE | RISK | PAUSED | CHURNED
model Client {
  id            String    @id @default(cuid())
  name          String
  niche         String?
  contact       String?
  source        String? // источник заявки
  status        String    @default("TEST")
  avgCheck      Float     @default(0) // абонплата, сом
  startedAt     DateTime  @default(now())
  churnedAt     DateTime?
  services      String    @default("") // CSV: TARGET,SITE,BOT,VIDEO
  adAccount     String? // на кого оформлен рекламный кабинет
  nextPaymentAt DateTime?
  notes         String?

  targetologId String?
  targetolog   User?   @relation("targetolog", fields: [targetologId], references: [id])
  accountId    String?
  account      User?   @relation("account", fields: [accountId], references: [id])

  paymentDay    Int? // число месяца, когда клиент платит (1–31)
  contractStart DateTime? // дата подписания договора
  contractEnd   DateTime? // окончание договора
  profitPercent Float? // % от прибыли клиента, если работаем за процент
  goal          String? // цель клиента: что считаем результатом
  agreement     String? // договорённости по работе
  targetCpl     Float? // ориентир по цене заявки
  sitePrice     Float? // стоимость разработки сайта
  botPrice      Float? // стоимость чат-бота
  videoPrice    Float? // стоимость монтажа

  // Портал клиента: логин задаёт агентство, отдельно от таблицы User
  portalLogin        String? @unique
  portalPasswordHash String?
  cardLast4          String? // последние 4 цифры карты клиента (приём оплат/расходов)
  cardHolder         String?
  tgChatId           String? // привязанный чат Telegram клиента (портал)
  tgLinkCode         String? @unique

  payments         Payment[]
  reports          AdReport[]
  tasks            Task[]
  members          ClientMember[]
  goals            Goal[]
  expenses         Expense[]
  incomes          Income[]
  marketingReports MarketingReport[]
  snapshots        ClientSnapshot[]
  links            ClientLink[]
  directions       Direction[]
  notifications    Notification[]
  adTransactions   AdTransaction[]
  createdAt        DateTime          @default(now())
}

/// Направление (продуктовая линейка) внутри проекта клиента — своя отчётность по таргету.
model Direction {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  reports AdReport[]
}

/// Участник проекта с индивидуальной ставкой (процент или фикс)
model ClientMember {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String // TARGETOLOG | ACCOUNT | CONTRACTOR
  rateType    String   @default("PERCENT") // PERCENT | FIXED — устар., оставлено для обратной совместимости
  rate        Float    @default(0) // устар., см. ratePercent/rateFixed
  ratePercent Float? // % от чека
  rateFixed   Float? // фикс, сом в месяц
  note        String?
  cardLast4   String? // карта для приёма оплат именно по этому проекту
  cardHolder  String?
  createdAt   DateTime @default(now())

  @@unique([clientId, userId, role])
}

/// Цели: по агентству (clientId = null) или по клиенту
model Goal {
  id        String   @id @default(cuid())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     String // "2026-08"
  metric    String // REVENUE | LEADS | CPL | CLIENTS | PROFIT
  target    Float
  comment   String?
  createdAt DateTime @default(now())

  @@unique([clientId, month, metric])
}

// kind: SUBSCRIPTION (абонплата) | SITE | BOT | VIDEO
// status: PAID | PENDING | DEBT
model Payment {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind           String    @default("SUBSCRIPTION")
  amount         Float
  status         String    @default("PENDING")
  method         String    @default("TRANSFER") // TRANSFER | CASH | INVOICE
  dueAt          DateTime // плановая дата оплаты
  paidAt         DateTime?
  periodMonth    String // "2026-08" — к какому месяцу относится выручка
  comment        String?
  // распределение (снимок на момент расчёта)
  execShare      Float     @default(0) // доля исполнителя (таргетолог/программист)
  reserve        Float     @default(0) // резерв на развитие
  ownerNet       Float     @default(0) // чистая прибыль владельца
  execUserId     String?
  accountId      String? // на какой счёт пришли деньги
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  screenshot     Bytes? // скрин подтверждения оплаты
  screenshotMime String?
  createdAt      DateTime  @default(now())
}

model AdReport {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  directionId String?
  direction   Direction? @relation(fields: [directionId], references: [id], onDelete: SetNull)
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id])
  periodFrom  DateTime
  periodTo    DateTime
  // Цель кампании (Meta/Instagram): LEADS | ENGAGEMENT | TRAFFIC | PROFILE_VISITS —
  // определяет, какие метрики ниже показывать в форме. "Потрачено" видно всегда.
  objective   String     @default("LEADS")
  budget      Float      @default(0) // выделенный рекламный бюджет
  spent       Float      @default(0)
  leads       Int        @default(0)
  actions     Int        @default(0) // целевые действия
  views       Int        @default(0) // просмотры — альтернативная метрика, когда заявки не считаем
  engagement  Int        @default(0) // вовлечённость (лайки/комментарии/сохранения/реакции)
  traffic     Int        @default(0) // переходы/клики по ссылке
  profileVisits Int      @default(0) // посещения профиля
  targetCpl   Float // порог решения, обязательное
  targetCpa   Float?
  bundles     String? // статус связок
  comment     String?

  // Скриншот рекламного кабинета
  screenshot     Bytes?
  screenshotMime String?
  // На какую карту пришло поступление за период: TARGETOLOG | CLIENT
  receivedToCard String?

  // Обратная связь клиента по отчёту
  clientSales       Int?
  clientConversion  Float?
  clientLeadQuality Int? // 1–5

  createdAt DateTime @default(now())
}

/// Финансы рекламного кабинета: разовые приходы/списания по кабинету со скрином подтверждения
/// (отдельно от еженедельного отчёта — фиксируется каждый раз, когда кабинет что-то списал/получил).
model AdTransaction {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind           String // INCOME (приход) | EXPENSE (списание)
  amount         Float
  comment        String?
  screenshot     Bytes?
  screenshotMime String?
  authorId       String?
  author         User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
}

// board: TARGET | DEV | VIDEO
// stage (TARGET): BRIEF, HYPOTHESES, SHOOTING, LAUNCH, FILTER, SCALE, UPDATE
model Task {
  id         String    @id @default(cuid())
  title      String
  board      String    @default("TARGET")
  stage      String    @default("BRIEF")
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   User?     @relation("assignee", fields: [assigneeId], references: [id])
  dueAt      DateTime?
  comment    String?
  done       Boolean   @default(false)
  order      Int       @default(0)
  createdAt  DateTime  @default(now())

  priority   String    @default("MEDIUM") // URGENT | HIGH | MEDIUM | LOW
  tags       String    @default("") // CSV ключей справочника TASK_TAG
  startedAt  DateTime? // когда задачу взяли в работу
  doneAt     DateTime? // когда закрыли — для отчёта по выполнению
  archivedAt DateTime? // архив: из доски убрана, но не удалена

  // Повтор создаётся по факту закрытия, а не по расписанию — иначе копятся дубли.
  recurrence         String? // DAILY | WEEKDAYS | WEEKLY | MONTHLY
  recurrenceParentId String?

  checklist TaskChecklistItem[]
  comments  TaskComment[]

  @@index([assigneeId, done])
  @@index([dueAt])
}

/// Лёгкий пункт чеклиста внутри задачи (не отдельная задача).
model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId, order])
}

/// Лента обсуждения задачи.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  text      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Шаблон набора задач: «запуск клиента», «закрытие месяца».
model TaskTemplate {
  id        String             @id @default(cuid())
  name      String
  hint      String?
  board     String             @default("TARGET")
  active    Boolean            @default(true)
  order     Int                @default(100)
  items     TaskTemplateItem[]
  createdAt DateTime           @default(now())
}

model TaskTemplateItem {
  id         String       @id @default(cuid())
  templateId String
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  stage      String       @default("BRIEF")
  priority   String       @default("MEDIUM")
  dueDays    Int? // через сколько дней от применения шаблона
  checklist  String       @default("") // пункты через перевод строки
  order      Int          @default(0)

  @@index([templateId, order])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String? // альтернатива userId — уведомление клиенту в портале
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind      String // PAYMENT_DUE | CPL_ALERT | NEW_LEAD | REPORT_DUE | TASK_DUE | REPORT_READY
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  dedupeKey String? // техническая метка для защиты от повторной отправки, пользователю не показывается
  createdAt DateTime @default(now())

  @@index([dedupeKey])
}

/// Счета: касса, банк, карта. Баланс считается из операций (как в UnityFinance/FADAMOS).
model Account {
  id         String   @id @default(cuid())
  name       String
  kind       String   @default("CASH") // CASH | BANK | CARD
  opening    Float    @default(0) // начальный остаток
  minBalance Float? // минимальный остаток, ниже которого предупреждаем
  active     Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())

  payments      Payment[]
  expenses      Expense[]
  incomes       Income[]
  transfersFrom Transfer[] @relation("from")
  transfersTo   Transfer[] @relation("to")
}

/// Прочие приходы, не связанные с оплатой клиента (возврат, партнёрка, продажа, внесение своих)
model Income {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("OTHER") // ключ категории
  amount      Float
  receivedAt  DateTime
  periodMonth String
  comment     String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

/// Перевод между счетами
model Transfer {
  id            String   @id @default(cuid())
  fromAccountId String
  fromAccount   Account  @relation("from", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId   String
  toAccount     Account  @relation("to", fields: [toAccountId], references: [id], onDelete: Cascade)
  amount        Float
  madeAt        DateTime
  periodMonth   String
  comment       String?
  createdAt     DateTime @default(now())
}

/// Универсальный справочник: категории, статусы, услуги, этапы, методы оплаты, источники.
/// type: EXPENSE_CATEGORY | INCOME_CATEGORY | CLIENT_STATUS | SERVICE | PAYMENT_METHOD |
///       PAYMENT_KIND | SOURCE | NICHE | STAGE_TARGET | STAGE_DEV | STAGE_VIDEO | ACCOUNT_KIND
model DictItem {
  id      String  @id @default(cuid())
  type    String
  key     String
  name    String
  color   String? // класс подсветки для статусов
  hint    String?
  order   Int     @default(100)
  builtin Boolean @default(false)
  active  Boolean @default(true)

  @@unique([type, key])
  @@index([type, order])
}

/// Расходы агентства. Категории: ADS, SALARY, SUBSCRIPTION, OFFICE, TAX, EDU, OTHER
/// status: PAID (оплачен) | PLANNED (запланирован)
model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("OTHER")
  amount      Float
  status      String   @default("PAID")
  method      String   @default("TRANSFER") // TRANSFER | CASH | CARD
  spentAt     DateTime // дата расхода (плановая или фактическая)
  periodMonth String // "2026-08" — к какому месяцу относится
  recurring   Boolean  @default(false) // ежемесячный
  comment     String?
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId      String? // кому платим (для выплат команде)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accountId   String? // с какого счёта оплачен
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

/// Ежедневные маркетинговые отчёты агентства (не привязаны к одному клиенту) — как в Unity.
model MarketingReport {
  id          String   @id @default(cuid())
  date        DateTime
  channel     String   @default("TARGET") // ключ справочника MARKETING_CHANNEL
  source      String? // ключ справочника MARKETING_SOURCE
  direction   String? // ключ справочника MARKETING_DIRECTION
  spend       Float    @default(0)
  currency    String   @default("KGS") // KGS | USD
  usdRate     Float? // курс на момент ввода, если currency=USD
  leads       Int      @default(0)
  impressions Int      @default(0)
  inquiries   Int      @default(0)
  notes       String?
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([date])
}

/// Замер показателей клиента: «Точка А» — как было на старте, «Точка Б» — как стало.
/// Для агентства меряем заявки, цену заявки, бюджет и выручку клиента.
model ClientSnapshot {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       String // POINT_A | POINT_B
  takenAt    DateTime
  leads      Int? // заявок в месяц
  cpl        Float? // цена заявки
  adSpend    Float? // рекламный бюджет в месяц
  revenue    Float? // выручка клиента
  conversion Float? // конверсия заявки в продажу, %
  note       String?
  createdAt  DateTime @default(now())

  @@index([clientId, type])
}

/// Полезные ссылки по клиенту: кабинет, таблица, сайт, доступы.
model ClientLink {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  url       String
  type      String   @default("OTHER") // ADS | SHEETS | SITE | CRM | OTHER
  createdAt DateTime @default(now())

  @@index([clientId])
}

/// Регламент = зона ответственности сотрудника: чек-лист того, что он ведёт.
/// items — JSON-массив строк, строка с «#» в начале открывает новый блок.
model Regulation {
  id          String   @id @default(cuid())
  title       String
  description String?
  color       String   @default("#6d5efc")
  items       String   @default("[]")
  notes       String?
  ownerId     String?
  owner       User?    @relation("regulationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignees   String   @default("") // CSV id сотрудников, кроме основного
  order       Int      @default(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model Setting {
  key   String @id
  value String
}

/// Состояние диалога с ботом: многошаговый ввод расхода, прихода, оплаты.
/// step — текущий шаг, data — накопленные значения в JSON.
model BotSession {
  id        String   @id @default(cuid())
  chatId    String   @unique
  flow      String // EXPENSE | INCOME | PAYMENT
  step      String
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
