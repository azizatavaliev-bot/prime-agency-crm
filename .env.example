# База: на Railway подставляется автоматически из Postgres-сервиса
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Секрет для подписи сессий — длинная случайная строка
JWT_SECRET="смените-на-длинную-случайную-строку"

# Адрес приложения (нужен для ссылок в Telegram)
APP_URL="https://your-app.up.railway.app"

# Демо-кнопки быстрого входа на странице логина. На проде НЕ включать.
DEMO_MODE=""

# Telegram-бот (необязательно)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
CRON_KEY=""
